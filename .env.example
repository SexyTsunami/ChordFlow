# Copy to .env.local and fill in only what you use.

# --- Optional official playlist APIs ---
# Public Spotify / YouTube links work without these (title + artist from the
# public page, first page of tracks). Add keys only for longer or private lists.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=

# --- AI chord estimates (title + artist → guessed structure) ---
# Add these in Vercel → Project → Settings → Environment Variables.
# Never put the real key in GitHub.
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_MODEL=gemini-3.5-flash-lite

# --- Optional ---
# After the first Vercel deploy, set this to your live URL, e.g. https://chordflow.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LYRICS_PROVIDER=
LYRICS_PROVIDER_API_KEY=
